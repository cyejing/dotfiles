[user]
    name = chenyejing
    email = chenyejing@didiglobal.com
[http "https://github.com"]
    proxy = http://127.0.0.1:1080
[http "https://gitlab.com"]
    proxy = http://127.0.0.1:1080
[color]
    ui = auto
[alias]
    f = pull
    p = push
    aa = add --all
    ap = add --patch
    bc = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
    ci = commit -v
    co = checkout
    pf = push --force-with-lease
    st = status
    sw = switch
    lg = log --graph --abbrev-commit --decorate --date=iso --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%ad%C(reset) %C(bold green)(%ar)%C(reset) - %s - %an %C(bold yellow)%d%C(reset)' --all
	pullall = "!f() { \\\n  echo \"=== 1. 拉取主项目最新代码 ===\"; \\\n  git pull \"$@\"; \\\n  echo \"\\n=== 2. 拉取所有子模块远程 main 分支最新代码 ===\"; \\\n  git submodule update --remote --init --recursive; \\\n  echo \"\\n✅ 主项目和子模块已全部更新到最新！\"; \\\n}; f"
	pushall = "!f() { \\\n  echo \"=== 1. 推送所有子模块修改 ===\"; \\\n  git submodule foreach --recursive \"git push || true\"; \\\n  echo \"\\n=== 2. 推送主项目修改 ===\"; \\\n  git push \"$@\"; \\\n  echo \"\\n✅ 主项目和子模块已全部推送！\"; \\\n}; f"
[fetch]
    prune = true
[pull]
    autostash = true
	rebase = false
    prune = true
[merge]
	autostash = true
[diff]
    colorMoved = zebra
[credential]
    helper = store
[core]
    editor = lvim
    excludesfile = ~/.gitignore
[difftool]
	prompt = false
	trustExitCode = true
[mergetool]
	trustExitCode = true
[mergetool "vimdiff"]
	path = lvim
[init]
	defaultBranch = main
[safe]
	directory = *
[submodule]
	recurse = true
	update = rebase
[push]
	recurseSubmodules = on-demand
